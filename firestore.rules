rules_version = '2';
// Rules revision v5. Firestore only supports rules_version '1' and '2'.
// Publish at: Firebase Console → Firestore → "lang" database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacherOf(code) {
      return signedIn() &&
        get(/databases/$(database)/documents/classrooms/$(code)).data.teacherUid == request.auth.uid;
    }

    // Each user's own drive, profile and settings
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /classrooms/{code} {
      // Any signed-in user can look up a class code to join it
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;

      // Class roster. A student manages only their own record; the teacher can see,
      // remove (removed: true) or delete everyone. A removed student cannot undo it.
      match /members/{memberUid} {
        function isSelf() {
          return signedIn() && request.auth.uid == memberUid;
        }
        function notRemoved(data) {
          return data.get('removed', false) != true;
        }
        allow read: if isSelf() || isTeacherOf(code);
        allow create: if isSelf() && notRemoved(request.resource.data);
        allow update: if isTeacherOf(code) ||
          (isSelf() && notRemoved(resource.data) && notRemoved(request.resource.data));
        allow delete: if isTeacherOf(code) || (isSelf() && notRemoved(resource.data));
      }

      // Assignments: everyone signed in can read; only the class's teacher can change them
      match /assignments/{assignmentId} {
        allow read: if signedIn();
        allow create, update, delete: if isTeacherOf(code);

        // Open until closesAt (due date + 10 days); assignments without closesAt never close
        function submissionsOpen() {
          let a = get(/databases/$(database)/documents/classrooms/$(code)/assignments/$(assignmentId)).data;
          return a.get('closesAt', null) == null || request.time <= a.closesAt;
        }

        // One submission per student, stored at their uid; no edits — unsubmit (delete) to redo it
        match /submissions/{subId} {
          allow read: if isTeacherOf(code) ||
            (signedIn() && resource.data.studentUid == request.auth.uid);
          allow create: if signedIn() && subId == request.auth.uid
                        && request.resource.data.studentUid == request.auth.uid
                        && submissionsOpen();
          allow delete: if isTeacherOf(code) ||
            (signedIn() && resource.data.studentUid == request.auth.uid && submissionsOpen());
        }
      }

      // General (non-assignment) submissions
      match /submissions/{subId} {
        allow read: if isTeacherOf(code) ||
          (signedIn() && resource.data.studentUid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
        allow delete: if isTeacherOf(code);
      }
    }

    // Shared worksheet links are public to view; only their creator can change or remove them
    match /sharedWorksheets/{token} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;
    }
  }
}
